# ============================================================
# Travel Buddy - Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Lines starting with # are comments and are ignored.
# ============================================================

# --- LLM Provider ---
# Which AI service to use. Options: openai, anthropic, ollama
# Default: openai
# LLM_PROVIDER=openai

# --- OpenAI (default) ---
# Get your key at: https://platform.openai.com/api-keys
LLM_API_KEY=your_api_key_here

# API endpoint. Change for OpenAI-compatible services (Azure, LM Studio, etc.)
# Default: https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# Model name. Examples: gpt-4o, gpt-4o-mini
# Default: gpt-4o
LLM_MODEL=gpt-4o

# --- Anthropic (optional) ---
# Only needed if LLM_PROVIDER=anthropic
# Get your key at: https://console.anthropic.com/settings/keys
# Install: pip install anthropic
# ANTHROPIC_API_KEY=your_anthropic_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Ollama (optional, free, runs locally) ---
# Only needed if LLM_PROVIDER=ollama
# Install Ollama: https://ollama.ai
# Then run: ollama pull llama3.1
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# --- Google Maps ---
# Required for place recommendations and travel plans.
# Get your key at: https://console.cloud.google.com/apis/credentials
# Enable these APIs in your project: Places API, Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- App Settings ---
# Interface language: en (English) or tr (Turkish)
# Default: tr
APP_LANG=tr
